@echo off
REM Сначала переходим в директорию скрипта!
cd /d "%~dp0"

chcp 65001 > nul
cls

echo.
echo ================================================================================
echo          УСТАНОВКА PYTORCH И ЗАВИСИМОСТЕЙ
echo ================================================================================
echo.
echo Это установит PyTorch и все необходимые библиотеки для CAS_ISIC
echo Время установки: 5-10 минут
echo.
pause

REM Проверка существования venv310
if not exist "%~dp0venv310\Scripts\activate.bat" (
    echo.
    echo ОШИБКА: Виртуальное окружение venv310 не найдено!
    echo Путь: %~dp0venv310\Scripts\activate.bat
    echo.
    echo Создаём виртуальное окружение...
    python -m venv venv310
    echo.
)

call "%~dp0venv310\Scripts\activate.bat"

python setup_pytorch_environment.py

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ================================================================================
    echo УСТАНОВКА ЗАВЕРШЕНА
    echo ================================================================================
    echo.
    echo Следующий шаг: Запустите 2_TRAIN_CAS.bat
    echo.
) else (
    echo.
    echo ================================================================================
    echo ОШИБКА УСТАНОВКИ
    echo ================================================================================
    echo.
)

pause



