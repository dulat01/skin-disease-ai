@echo off
REM Переход в директорию скрипта
cd /d "%~dp0"

chcp 65001 > nul
cls

echo.
echo ================================================================================
echo          ТЕСТИРОВАНИЕ ОДНОГО ИЗОБРАЖЕНИЯ
echo ================================================================================
echo.
echo Этот скрипт запустит графический интерфейс для диагностики
echo.
echo ВОЗМОЖНОСТИ:
echo    [+] Загрузка изображения через диалог
echo    [+] Показ вероятностей для всех классов
echo    [+] Отображение типа (злокачественная/доброкачественная)
echo    [+] Визуализация результатов
echo.
echo ВАЖНО: Это только помощь в диагностике!
echo    Всегда консультируйтесь с врачом-дерматологом!
echo.
pause

echo.
echo Активация виртуального окружения...

REM Проверка существования venv310
if not exist "%~dp0venv310\Scripts\activate.bat" (
    echo.
    echo ОШИБКА: Виртуальное окружение venv310 не найдено!
    echo Путь: %~dp0venv310\Scripts\activate.bat
    echo.
    echo Пожалуйста, запустите сначала: install.bat
    echo.
    pause
    exit /b 1
)

call "%~dp0venv310\Scripts\activate.bat"

if errorlevel 1 (
    echo.
    echo ОШИБКА активации виртуального окружения!
    echo.
    pause
    exit /b 1
)

echo.
echo ================================================================================
echo ЗАПУСК ИНТЕРФЕЙСА
echo ================================================================================
echo.

python predict_single_image.py

if errorlevel 1 (
    echo.
    echo Произошла ошибка!
    echo.
    pause
    exit /b 1
)

echo.
echo ================================================================================
echo ТЕСТИРОВАНИЕ ЗАВЕРШЕНО
echo ================================================================================
echo.
pause

